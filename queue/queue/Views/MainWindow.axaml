<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:queue.ViewModels"
        x:Class="queue.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Очередь"
        Width="400" Height="450"
        WindowStartupLocation="CenterScreen"
        MinWidth="350" MinHeight="400">
    
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                BorderBrush="Gray" 
                BorderThickness="1" 
                Padding="10" 
                Margin="0,0,0,10" 
                CornerRadius="5">
            <StackPanel>
                <TextBlock Text="Информация об очереди" 
                          FontWeight="Bold" 
                          Margin="0,0,0,5"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Grid.Column="0" 
                               Text="Текущий элемент:" 
                               Margin="0,0,5,0"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" 
                               Text="{Binding CurrentItem}" 
                               FontWeight="Bold" 
                               Foreground="Blue"/>
                    
                    <TextBlock Grid.Row="0" Grid.Column="2" 
                               Text="Количество:" 
                               Margin="20,0,5,0"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" 
                               Text="{Binding Count}" 
                               FontWeight="Bold"/>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" 
                               Text="Очередь пуста:" 
                               Margin="0,5,5,0"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="True" 
                                   FontWeight="Bold" 
                                   Foreground="Green"
                                   IsVisible="{Binding IsEmpty}"/>
                        <TextBlock Text="False" 
                                   FontWeight="Bold" 
                                   Foreground="Red"
                                   IsVisible="{Binding !IsEmpty}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" 
                BorderBrush="Gray" 
                BorderThickness="1" 
                Padding="10" 
                Margin="0,0,0,10" 
                CornerRadius="5">
            <StackPanel>
                <TextBlock Text="Добавить элемент" 
                          FontWeight="Bold" 
                          Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox Grid.Column="0" 
                             Text="{Binding NewItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="0,0,5,0" 
                             Padding="5" 
                             Watermark="Введите текст для добавления"/>
                    <Button Grid.Column="1" 
                            Content="Добавить" 
                            Command="{Binding AddCommand}" 
                            Padding="10,5"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" 
                BorderBrush="Gray" 
                BorderThickness="1" 
                Padding="10" 
                Margin="0,0,0,10" 
                CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" 
                           Text="Элементы очереди (от начала к концу)" 
                           FontWeight="Bold" 
                           Margin="0,0,0,5"/>
                
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="LightGray" 
                                        BorderThickness="0,0,0,1" 
                                        Padding="5">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0" 
                                                   Text="•" 
                                                   Margin="0,0,5,0"
                                                   Foreground="Gray"/>
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding}" 
                                                   FontSize="14"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <TextBlock Grid.Row="2" 
                           Text="{Binding Count, StringFormat='Всего элементов: {0}'}" 
                           Margin="0,5,0,0"
                           FontStyle="Italic"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" 
                BorderBrush="Gray" 
                BorderThickness="1" 
                Padding="10" 
                CornerRadius="5">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" 
                            Content="Извлечь элемент" 
                            Command="{Binding RemoveCommand}" 
                            Margin="0,0,5,0" 
                            Padding="10,5"/>
                    <Button Grid.Column="1" 
                            Content="Очистить очередь" 
                            Command="{Binding ClearCommand}" 
                            Padding="10,5"/>
                </Grid>
                
                <TextBlock Text="{Binding StatusMessage}" 
                           Margin="0,10,0,0" 
                           Foreground="Green" 
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>