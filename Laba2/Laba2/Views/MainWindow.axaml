<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Laba2.ViewModels"
        xmlns:models="using:Laba2.Models"
        x:Class="Laba2.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Авиационный симулятор"
        Width="800" Height="600"
        WindowStartupLocation="CenterScreen"
        MinWidth="700" MinHeight="500">
    
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель - Создание и список -->
        <Border Grid.Row="0" Grid.Column="0" 
                Grid.RowSpan="2"
                BorderBrush="Gray" 
                BorderThickness="1" 
                Padding="10" 
                Margin="0,0,10,10" 
                CornerRadius="5"
                Background="#F5F5F5">
            
            <StackPanel>
                <TextBlock Text="СОЗДАНИЕ ОБЪЕКТА" 
                          FontWeight="Bold" 
                          FontSize="14"
                          Margin="0,0,0,10"/>
                
                <TextBlock Text="Тип:" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton Content="Самолет" 
                                 IsChecked="{Binding IsAirplaneSelected}"
                                 GroupName="VehicleType"
                                 Margin="0,0,20,0"/>
                    <RadioButton Content="Вертолет" 
                                 IsChecked="{Binding !IsAirplaneSelected}"
                                 GroupName="VehicleType"/>
                </StackPanel>
                
                <TextBlock Text="Название:" Margin="0,0,0,2"/>
                <TextBox Text="{Binding NewVehicleName}" 
                         Padding="5"
                         Margin="0,0,0,10"
                         Watermark="Введите название"/>
                
                <StackPanel IsVisible="{Binding IsAirplaneSelected}">
                    <TextBlock Text="Длина полосы (м):" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding RunwayLength}" 
                             Padding="5"
                             Margin="0,0,0,10"
                             Watermark="Длина взлетной полосы"/>
                </StackPanel>
                
                <Button Content="СОЗДАТЬ" 
                        Command="{Binding CreateCommand}"
                        Margin="0,5,0,15"
                        Padding="10,8"
                        HorizontalAlignment="Stretch"
                        Background="LightBlue"/>
                
                <TextBlock Text="СПИСОК ОБЪЕКТОВ" 
                          FontWeight="Bold" 
                          FontSize="14"
                          Margin="0,10,0,5"/>
                
                <ListBox ItemsSource="{Binding Vehicles}"
                         SelectedItem="{Binding SelectedVehicle}"
                         Height="200"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="5">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" 
                                              FontWeight="Bold"/>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding}" 
                                                  FontSize="11"
                                                  Opacity="0.7"/>
                                        <TextBlock FontSize="11" Foreground="Blue">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} м">
                                                    <Binding Path="Altitude"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                
                <Button Content="УДАЛИТЬ ВЫБРАННОЕ" 
                        Command="{Binding DeleteCommand}"
                        Margin="0,10,0,0"
                        Padding="10,5"
                        HorizontalAlignment="Stretch"
                        Background="LightPink"/>
            </StackPanel>
        </Border>

        <!-- Правая панель - Информация и управление -->
        <Border Grid.Row="0" Grid.Column="1" 
                BorderBrush="Gray" 
                BorderThickness="1" 
                Padding="15" 
                Margin="0,0,0,10" 
                CornerRadius="5">
            
            <StackPanel>
                <TextBlock Text="ИНФОРМАЦИЯ О ВЫБРАННОМ ОБЪЕКТЕ" 
                          FontWeight="Bold" 
                          FontSize="14"
                          Margin="0,0,0,15"/>
                
                <Border BorderBrush="LightGray" 
                        BorderThickness="1" 
                        Padding="15" 
                        CornerRadius="5"
                        Background="#FAFAFA">
                    
                    <StackPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Название:" FontWeight="Bold" Margin="0,0,10,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedVehicleName}" Margin="0,0,0,5"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Тип:" FontWeight="Bold" Margin="0,0,10,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedVehicleType}" Margin="0,0,0,5"/>
                            
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Высота:" FontWeight="Bold" Margin="0,0,10,5"/>
                            <TextBlock Grid.Row="2" Grid.Column="1">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0:F0} м">
                                        <Binding Path="SelectedVehicleAltitude"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Статус:" FontWeight="Bold" Margin="0,0,10,5"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" 
                                       Text="{Binding SelectedVehicleStatus}" 
                                       Foreground="{Binding SelectedVehicleStatusColor}"
                                       FontWeight="Bold"
                                       Margin="0,0,0,5"/>
                        </Grid>
                        
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center" 
                                    Margin="0,20,0,0">
                            
                            <Button Content="ВЗЛЕТ" 
                                    Command="{Binding TakeOffCommand}"
                                    Margin="0,0,10,0"
                                    Padding="25,10"
                                    Background="LightGreen"
                                    FontWeight="Bold"/>
                            
                            <Button Content="ПОСАДКА" 
                                    Command="{Binding LandCommand}"
                                    Padding="25,10"
                                    Background="LightCoral"
                                    FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Журнал событий -->
        <Border Grid.Row="1" Grid.Column="1" 
                BorderBrush="Gray" 
                BorderThickness="1" 
                Padding="10" 
                CornerRadius="5"
                Background="LightYellow">
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" 
                               Text="ЖУРНАЛ СОБЫТИЙ" 
                               FontWeight="Bold" 
                               FontSize="14"/>
                    
                    <Button Grid.Column="1" 
                            Content="Очистить" 
                            Command="{Binding ClearEventsCommand}"
                            Padding="10,3"
                            FontSize="11"/>
                </Grid>
                
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FlightEvents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="LightGray" 
                                        BorderThickness="0,0,0,1" 
                                        Padding="5">
                                    <TextBlock Text="{Binding}" 
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Статус бар -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                BorderBrush="Gray" 
                BorderThickness="1" 
                Padding="8" 
                Margin="0,10,0,0" 
                CornerRadius="3"
                Background="#E0E0E0">
            
            <TextBlock Text="{Binding StatusMessage}" 
                       Foreground="Blue" 
                       VerticalAlignment="Center"
                       FontSize="11"/>
        </Border>
    </Grid>
</Window>